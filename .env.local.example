# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Without any of these the site still works on localhost: bookings are saved in .data/db.json,
# payment is "pay at clinic" only, and messages are printed in the terminal.

# ---- Demo deployment ----
# SITE_NOINDEX=1 keeps Google from listing a demo/testing site. Remove it when the real site goes live.
SITE_NOINDEX=

# ---- Staff admin (required to open /admin) ----
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=paste-a-long-random-string-here   # required in production. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Database (production) ----
# STORE=supabase turns on the Supabase database. Leave it out on localhost to use the local file.
STORE=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=   # service_role key (server only, keep it secret)

# ---- Online payments (Razorpay). Leave empty to disable online payment ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Confirmation messages ----
# console (default, prints in the terminal) | webhook | whatsapp
NOTIFY_PROVIDER=console
NOTIFY_STAFF_PHONE=          # clinic phone to alert on every booking, with country code, e.g. 919XXXXXXXXX
NOTIFY_WEBHOOK_URL=          # for NOTIFY_PROVIDER=webhook: receives JSON { to, text, bookingId }
WHATSAPP_TOKEN=              # for NOTIFY_PROVIDER=whatsapp (Meta WhatsApp Cloud API)
WHATSAPP_PHONE_ID=
